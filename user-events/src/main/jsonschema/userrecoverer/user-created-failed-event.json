{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserCreatedFailedEvent",
  "type": "object",
  "properties": {
    "sourceService": {
      "type": "string",
      "description": "Имя сервиса-источника события"
    },
    "sourceTopic": {
      "type": "string",
      "description": "Kafka топик, из которого получено исходное событие"
    },
    "sourcePartition": {
      "type": "integer",
      "description": "Номер партиции Kafka"
    },
    "sourceOffset": {
      "type": "integer",
      "existingJavaType": "java.lang.Long",
      "description": "Смещение в партиции Kafka"
    },
    "sourceTimestamp": {
      "type": "string",
      "existingJavaType": "java.time.Instant" ,
      "format": "date-time",
      "description": "Временная метка исходного события"
    },
    "userId": {
      "type": "string",
      "format": "uuid",
      "description": "Уникальный идентификатор пользователя"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email пользователя"
    },
    "firstName": {
      "type": "string",
      "description": "Имя пользователя"
    },
    "lastName": {
      "type": "string",
      "description": "Фамилия пользователя"
    },
    "phone": {
      "type": "string",
      "description": "Телефон пользователя"
    },
    "errorType": {
      "type": "string",
      "description": "Тип ошибки (класс исключения)"
    },
    "errorMessage": {
      "type": "string",
      "description": "Сообщение об ошибке"
    },
    "errorStack": {
      "type": "string",
      "description": "Стек-трейс ошибки"
    },
    "retryCount": {
      "type": "integer",
      "description": "Текущее количество попыток повторной обработки"
    },
    "maxRetryCount": {
      "type": "integer",
      "description": "Максимальное количество попыток повторной обработки"
    }
  },
  "required": [
    "sourceService",
    "userId",
    "email",
    "firstName",
    "lastName",
    "errorType",
    "errorMessage"
  ]
}